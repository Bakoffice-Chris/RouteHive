# Copy this to .env for local dev. Railway: set these in the service's Variables tab instead.

JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# Leave unset for local dev (uses SQLite at ./data/dev.sqlite3).
# Railway sets this automatically when you add the Postgres plugin.
# DATABASE_URL=postgres://user:pass@host:port/dbname

# Vendor keys - add once you've picked providers (not required for the CSV-import MVP path)
# ENRICHMENT_API_KEY=
# GOOGLE_DIRECTIONS_API_KEY=

# First admin account - set these on deploy to auto-create your first login
# instead of calling POST /api/auth/register-tenant manually
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# TENANT_NAME=

# Maricopa County Assessor public API - free token, request at
# https://mcassessor.maricopa.gov/contact/ (select "API Question/Token")
# MCASSESSOR_API_TOKEN=
# MARICOPA_REQUEST_DELAY_MS=300

# BusyBee AI Assistant - pre-visit briefs, powered by the Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Self-service booking page - set to the deployed booking app's URL so
# generated links point at the right place instead of localhost
# BOOKING_PAGE_URL=https://your-booking-app.up.railway.app
